# データベース設定
DATABASE_URL_SUPABASE=postgresql://user:password@host:port/database
DATABASE_URL_LOCAL=postgresql://user:password@localhost:5432/questly_db
DEVELOPMENT=False

# JWT認証設定
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# メール設定（オプション - メール認証を使用する場合）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your-email@gmail.com

# フロントエンド設定
FRONTEND_URL=http://localhost:3000

# デバッグ設定
DEBUG=True

# サーバー設定
HOST=0.0.0.0
PORT=8000